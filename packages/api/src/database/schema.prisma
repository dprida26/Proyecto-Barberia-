generator client {
  provider      = "prisma-client-js"
  output        = "./generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  BARBER
}

enum BarberStatus {
  AVAILABLE
  WAITING
  IN_SERVICE
}

enum ServiceSessionStatus {
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum AuditAction {
  SERVICE_STARTED
  SERVICE_FINISHED
  SERVICE_CANCELLED
  SERVICE_CATALOG_CREATED
  SERVICE_CATALOG_UPDATED
  SERVICE_PRICE_CHANGED
  SERVICE_COMMISSION_OVERRIDE_SET
  SERVICE_COMMISSION_OVERRIDE_REMOVED
  BARBER_CREATED
  BARBER_UPDATED
  BARBER_DEACTIVATED
  BARBER_DELETED
  USER_LOGIN
  TENANT_SETTINGS_UPDATED
  TENANT_LOGO_UPDATED
}

model Tenant {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  logoUrl       String?
  phone         String?
  address       String?
  businessHours String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  users                    User[]
  services                 ServiceCatalog[]
  serviceSessions          ServiceSession[]
  auditLogs                AuditLog[]
  barberServiceCommissions BarberServiceCommission[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  phone        String?
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  barber    Barber?
  auditLogs AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Barber {
  id                String       @id @default(uuid())
  tenantId          String
  userId            String       @unique
  displayName       String
  isAvailable       Boolean      @default(true)
  currentStatus     BarberStatus @default(AVAILABLE)
  commissionPercent Decimal      @default(50.00) @db.Decimal(5, 2)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)

  user             User                       @relation(fields: [userId], references: [id])
  serviceSessions  ServiceSession[]
  serviceCommissions BarberServiceCommission[]

  @@index([tenantId])
  @@map("barbers")
}

model ServiceCatalog {
  id                   String   @id @default(uuid())
  tenantId             String
  name                 String
  description          String?
  category             String?
  durationEstimateMin  Int
  currentPrice         Decimal  @db.Decimal(10, 2)
  wednesdayPrice       Decimal? @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  serviceSessionItems ServiceSessionItem[]
  commissionOverrides BarberServiceCommission[]

  @@index([tenantId])
  @@map("service_catalog")
}

model ServiceSession {
  id                            String               @id @default(uuid())
  tenantId                      String
  barberId                      String
  clientNameFree                String?
  paymentMethod                 PaymentMethod        @default(CASH)
  totalPrice                    Decimal              @db.Decimal(10, 2)
  commissionPercentAtCompletion Decimal?             @db.Decimal(5, 2)
  status                        ServiceSessionStatus @default(IN_SERVICE)
  startedAt                     DateTime             @default(now()) @db.Timestamptz(3)
  endedAt                       DateTime?            @db.Timestamptz(3)
  durationSeconds               Int?
  cancelReason                  String?
  createdAt                     DateTime             @default(now()) @db.Timestamptz(3)

  tenant Tenant               @relation(fields: [tenantId], references: [id])
  barber Barber               @relation(fields: [barberId], references: [id])
  items  ServiceSessionItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startedAt])
  @@index([barberId, status])
  @@map("service_sessions")
}

model ServiceSessionItem {
  id                String   @id @default(uuid())
  sessionId         String
  serviceId         String
  priceAtStart      Decimal  @db.Decimal(10, 2)
  commissionPercent Decimal  @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  session ServiceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id])

  @@index([sessionId])
  @@map("service_session_items")
}

model BarberServiceCommission {
  id                String   @id @default(uuid())
  tenantId          String
  barberId          String
  serviceId         String
  commissionPercent Decimal  @db.Decimal(5, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  barber  Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  service ServiceCatalog @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([barberId, serviceId])
  @@index([tenantId])
  @@index([serviceId])
  @@map("barber_service_commissions")
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}
