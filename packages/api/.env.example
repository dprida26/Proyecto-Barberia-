NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://barberops:barberops@localhost:5432/barberops

JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Cloudflare R2 (opcional). Si se omiten estas variables, el logo del negocio
# se guarda en el filesystem local (uploads/) -- valido para desarrollo, pero
# NO persiste en plataformas con filesystem efimero como Render.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://logos.tu-dominio.com
